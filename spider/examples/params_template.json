{
    "io": {
        "dtime_file": "PATH/TO/dtimes.csv",
        "station_file": "PATH/TO/stations.csv",
        "catalog_infile": "PATH/TO/events.csv",
        "catalog_outfile": "PATH/TO/output_catalog.csv",
        "samples_outfile": "PATH/TO/output_samples.h5",
        "checkpoint_dir": "PATH/TO/checkpoints/",
        "checkpoint_interval": 1000,
        "sample_write_interval": 1000,
        "save_every_n": 10,
        "write_samples": true
    },
    "model": {
        "model_file": "PATH/TO/eikonet_model.pt",
        "domain": {
            "lon_min": -120.0,
            "lat_min": 35.0,
            "z_min": -5.0,
            "z_max": 30.0,
            "scale": 400.0
        },
        "priors": {
            "event": {
                "enabled": true,
                "type": "gaussian",
                "params": {
                    "std": [
                        0.2,
                        0.2,
                        0.2,
                        0.1
                    ]
                },
                "hyper": {
                    "enabled": false,
                    "type": "wishart_precision",
                    "params": {
                        "df": 1000,
                        "scale_std": [
                            0.01,
                            0.01,
                            0.01,
                            0.01
                        ]
                    },
                    "update": {
                        "every_epochs": 1
                    }
                }
            }
        },
        "filters": {
            "dtimes": {
                "remove_duplicates": true,
                "max_abs_input_dt": 99999,
                "dtime_thin_frac": 1.0,
                "flip_dt_sign": false,
                "cc_min": 0.0
            },
            "events": {
                "min_dtimes": 1,
                "min_unique_phase_per_event": 1,
                "min_dtimes_per_pair": 1,
                "min_event_degree": 1,
                "min_events_per_cluster": 0,
                "max_pair_station_ratio": 1.0,
                "ratio_filter_phase": "before",
                "linearization_error": {
                    "enabled": false,
                    "phase": "before",
                    "max_ratio": 0.05,
                    "batch_size": 50000,
                    "sample_size": 200000,
                    "log_every_batches": 25
                }
            },
            "residual": {
                "enabled": false,
                "method": "mad",
                "mad_sigma": 3.0,
                "abs_max": 0.5
            }
        },
        "likelihoods": {
            "locate_map": {
                "type": "laplace",
                "phase_unc": [
                    0.03,
                    0.03
                ]
            },
            "sample": {
                "type": "correlated_gaussian",
                "phase_unc": [
                    0.03,
                    0.03
                ],
                "shared_event_re": {
                    "enabled": true,
                    "model": {
                        "group_by": "station_phase",
                        "tau_s": [
                            0.03,
                            0.04
                        ],
                        "cluster": {
                            "mode": "none",
                            "k": 1
                        }
                    },
                    "limits": {
                        "max_nodes": 25000,
                        "max_rows": 1500000
                    },
                    "fallback": {
                        "to_diag": true,
                        "abort_on_pcg_fallback": false
                    },
                    "numerics": {
                        "jitter0": 1e-08,
                        "jitter_max": 0.001
                    },
                    "solver": {
                        "kind": "pcg",
                        "max_iters": 50,
                        "min_iters": 2,
                        "tol": 0.001,
                        "batched": true,
                        "node_bin_edges": [
                            512,
                            1024,
                            2048,
                            4096,
                            8192,
                            16384,
                            32768
                        ],
                        "warm_start": false,
                        "cache_max_entries": 8,
                        "prefetch_grouping": false,
                        "profile_micro_steps": false,
                        "merge_sparse_node_bins": true,
                        "min_groups_per_node_bin": 32,
                        "max_node_bins_per_node": 4,
                        "precompute": {
                            "enabled": false,
                            "device": "gpu"
                        }
                    },
                    "edge_weights": {
                        "mode": "uniform",
                        "ell_km": 1.0,
                        "eps_km": 0.001,
                        "power": 1.0,
                        "scale_km": 1.0,
                        "global_scale": 1.0,
                        "normalize": false
                    },
                    "autotune": {
                        "enabled": true,
                        "observe_epochs": 1,
                        "latest_epoch": 2,
                        "min_groups": 128,
                        "max_node_bins": 8,
                        "min_groups_per_node_bin": 24,
                        "min_node_bin": 512,
                        "min_gain": 0.08,
                        "raise_nodes_cap": true,
                        "nodes_cap_max": 65536
                    },
                    "logging": {
                        "quiet": true,
                        "stats_log_every_epochs": 0
                    }
                }
            }
        }
    },
    "inference": {
        "compute": {
            "devices": [
                0
            ]
        },
        "sampler": {
            "backend": "sghmc",
            "epochs_per_phase": [
                200,
                0,
                10,
                10000
            ],
            "lr": [
                0.001,
                1e-05,
                1e-05,
                1e-05
            ],
            "temperature": 1.0,
            "noise_scale_mult": 1.0,
            "sghmc_alpha": 0.01,
            "eps": 1e-08,
            "preconditioning": {
                "enabled": true,
                "type": "rmsprop",
                "include_gamma": false
            },
            "beta": 0.999,
            "freeze_preconditioner_sampling": false
        },
        "batching": {
            "standard": {
                "warmup": 250000,
                "sgld": 1000000,
                "shuffle": false
            },
            "event_batches": {
                "enabled": false,
                "events_per_batch": 50,
                "max_edges_per_batch": 200000,
                "bucket_reorder_all": false,
                "bucket_reuse_epochs": 1
            }
        },
        "safety": {
            "max_abs_dX": null
        },
        "runtime": {
            "cuda_empty_cache_every": 0,
            "reset_batch_numbers": true,
            "clear_samples_on_reset": true,
            "min_samples_to_save": 10,
            "verbose": true,
            "cluster_events": false,
            "gauge_projection": {
                "enabled": false,
                "mode": "global",
                "dims": [
                    0,
                    1,
                    2
                ],
                "apply_noise": true,
                "apply_momentum": true
            }
        }
    },
    "observability": {
        "wandb": {
            "enabled": false,
            "project_name": null,
            "run_name": null
        },
        "diagnostics": {
            "pair_count_stats_enable": true,
            "sgld_log_gnoise": false,
            "sgld_log_temperature": false,
            "display_precond_every": 50,
            "wandb": {
                "enabled": false,
                "groups": {
                    "core": true
                }
            },
            "ess_online": {
                "enabled": false,
                "every_n_samples": 50,
                "n_events": 64,
                "seed": 0,
                "window": 512,
                "max_lag": 128,
                "dims": [
                    0,
                    1,
                    2,
                    3
                ]
            }
        }
    }
}
