{
    "io": {
        "dtime_file": "/path/to/dtimes.csv",
        "station_file": "/path/to/stations.csv",
        "catalog_infile": "/path/to/catalog.csv",
        "catalog_outfile": "/path/to/output_catalog.csv",
        "samples_outfile": "/path/to/SPIDER_samples.h5",
        "checkpoint_dir": "/path/to/checkpoints/",
        "checkpoint_interval": 25,
        "save_every_n": 10,
        "sample_write_interval": 25,
        "write_samples": true
    },
    "wandb": {
        "enabled": false,
        "project_name": "spider",
        "run_name": "example_run",
        "log_every_batches": 0,
        "max_median_samples": 200000,
        "residual_sample_size": 200000,
        "precond_sample_size": 200000
    },
    "model": {
        "model_file": "/path/to/model_state_dict.pt",
        "domain": {
            "lon_min": -118.5,
            "lat_min": 32.5,
            "z_min": -5.0,
            "z_max": 80.0,
            "scale": 400.0
        },
        "priors": {
            "event": {
                "enabled": true,
                "params": {
                    "std": [0.2, 0.2, 0.2, 0.1]
                }
            }
        },
        "likelihood": {
            "type": "correlated_gaussian",
            "phase_unc": [0.01, 0.01],
            "shared_event_re": {
                "enabled": true,
                "grouping": "station_phase",
                "tau_s": [0.03, 0.04],
                "max_nodes_per_group": 25000,
                "max_rows_per_group": 1500000,
                "solver": "pcg",
                "pcg_max_iters": 20,
                "pcg_tol": 0.005,
                "whitening": {
                    "solver": "pcg",
                    "pcg_max_iters": 50,
                    "pcg_tol": 0.0005,
                    "pcg_min_iters": 1,
                    "edge_weighting": "distance_power",
                    "edge_weight_power": 0.9,
                    "edge_weight_scale_km": 4.7,
                    "edge_weight_global_scale": 1.0,
                    "edge_weight_normalize": true,
                    "edge_weight_eps_km": 0.001
                }
            }
        },
        "filters": {
            "dtimes": {
                "remove_duplicates": true,
                "max_abs_input_dt": 99999,
                "dtime_thin_frac": 1.0,
                "flip_dt_sign": false,
                "cc_min": 0.0
            },
            "events": {
                "min_dtimes": 1,
                "min_unique_phase_per_event": 10,
                "min_dtimes_per_pair": 4,
                "min_event_degree": 5,
                "min_events_per_cluster": 0,
                "max_pair_station_ratio": 1.0,
                "ratio_filter_phase": "before",
                "linearization_error": {
                    "enabled": true,
                    "phase": "before",
                    "max_ratio": 0.05,
                    "batch_size": 50000,
                    "sample_size": 200000,
                    "log_every_batches": 25
                }
            },
            "residual": {
                "enabled": true,
                "method": "mad",
                "mad_sigma": 4.0,
                "abs_max": 0.5
            }
        }
    },
    "inference": {
        "compute": {
            "devices": [0]
        },
        "sampler": {
            "backend": "psgld",
            "epochs_per_phase": [150, 0, 0, 100000],
            "lr": [0.001, 0.005, 0.003, 0.001],
            "dt_lr_mult": 1.0,
            "temperature": 1.0,
            "eps": 1e-5,
            "beta": 0.99,
            "preconditioning": {
                "enabled": true,
                "type": "rmsprop",
                "include_gamma": false
            },
            "monge": {
                "alpha": 1.0,
                "ema_beta": 0.9,
                "eps": 1e-12
            },
            "freeze_preconditioner_sampling": false
        },
        "batching": {
            "standard": {
                "warmup": 1500000,
                "sgld": 1500000,
                "shuffle": false
            }
        }
    },
    "runtime": {
        "seed": 0,
        "verbose": true,
        "clear_samples_on_reset": true,
        "safety": {
            "max_abs_dX": [2.0, 2.0, 2.0, 1.0]
        },
        "gauge_projection": {
            "enabled": true,
            "mode": "cluster",
            "dims": [0, 1, 2, 3],
            "apply_noise": true,
            "apply_momentum": false
        }
    }
}
