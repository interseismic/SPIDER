{
    "io": {
        "dtime_file": "./dtimes_with_noise_from_truth.csv",
        "station_file": "./station.csv",
        "catalog_infile": "./events_from_prior.csv",
        "catalog_outfile": "./SPIDER_out.cat",
        "samples_outfile": "./SPIDER_samples.h5",
        "checkpoint_dir": "./checkpoints/",
        "checkpoint_interval": 100,
        "save_every_n": 10,
        "write_samples": true
    },
    "wandb": {
        "enabled": true,
        "project_name": "spider_paper",
        "run_name": "ridgecrest_syn"
    },
    "model": {
        "model_file": "./model_state_dict.pt",
        "domain": {
            "lon_min": -119.6127,
            "lat_min": 33.8856,
            "z_min": -2.0,
            "z_max": 30.0,
            "scale": 400.0
        },
        "priors": {
            "event": {
                "enabled": true,
                "type": "gaussian",
                "params": {
                    "std": [
                        0.5,
                        0.5,
                        0.5,
                        0.2
                    ]
                }
            },
            "centroid": {
                "enabled": true,
                "type": "gaussian",
                "params": {
                    "std": [
                        0.01,
                        0.01,
                        0.01,
                        0.01
                    ]
                }
            }
        },
        "likelihoods": {
            "locate_map": {
                "type": "laplace",
                "phase_unc": [0.02, 0.03]
            },
            "sample": {
                "type": "correlated_gaussian",
                "phase_unc": [0.02, 0.03],
                "sigma_distance_linear": {
                    "enabled": false,
                    "slope_s_per_km": [0.0028, 0.0093],
                    "min_sigma_s": [0.0, 0.0],
                    "max_dist_km": 200.0
                },
                "shared_event_re": {
                    "enabled": true,
                    "grouping": "station_phase",
                    "tau_s": [0.033, 0.06],
                    "max_nodes_per_group": 25000,
                    "max_rows_per_group": 1500000,
                    "solver": "pcg_sparse",
                    "pcg_max_iters": 20,
                    "pcg_tol": 5e-3,
                    "cache_max_entries": 32,
                    "gpu_max_groups_per_batch": 128,
                    "gpu_max_edges_per_batch": 1500000,
                    "gpu_reuse_pcg_init": true,
                    "gpu_profile": true,
                    "whitening": {
                      "enabled": true,
                      "solver": "pcg",
                      "pcg_batched": true,
                      "pcg_bucket_nodes": [4096, 16384, 25000],
                      "pcg_max_iters": 100,
                      "pcg_tol": 3e-4,
                      "pcg_min_iters": 2,
                      "precompute": true,
                      "precompute_device": "gpu",
                      "edge_weighting": "distance_power",
                      "edge_weight_power": 0.25,
                      "edge_weight_scale_km": 40.0,
                      "edge_weight_global_scale": 1.0,
                      "edge_weight_normalize": true,
                      "edge_weight_eps_km": 1e-3,
                      "cache_max_entries": 32
                    }
                }
            }
        },
        "filters": {
            "dtimes": {
                "remove_duplicates": true,
                "max_abs_input_dt": 99999,
                "dtime_thin_frac": 1.0,
                "flip_dt_sign": false,
                "cc_min": 0.0
            },
            "events": {
                "min_dtimes": 1,
                "min_unique_phase_per_event": 8,
                "min_dtimes_per_pair": 1,
                "min_event_degree": 3,
                "min_events_per_cluster": 0,
                "max_pair_station_ratio": 1.0,
                "ratio_filter_phase": "before",
                "linearization_error": {
                    "enabled": true,
                    "phase": "before",
                    "max_ratio": 0.05,
                    "batch_size": 50000,
                    "sample_size": 200000,
                    "log_every_batches": 25
                }
            },
            "residual": {
                "enabled": false,
                "method": "mad",
                "mad_sigma": 3.0,
                "abs_max": 99999
            }
        }
    },
    "inference": {
        "compute": {
            "devices": [
                1,3
            ]
        },
        "sampler": {
            "backend": "psgld",
            "epochs_per_phase": [1000, 100,100, 100000],
            "lr": [1e-3, 1e-2, 1e-2, 1e-2],
            "dt_lr_mult": 0.2,
            "temperature": 1.0,
            "eps": 1e-5,
            "sghmc_alpha": 1e-1,
            "preconditioning": {
                "enabled": true,
                "type": "rmsprop",
                "include_gamma": false
            },
            "beta": 0.99,
            "freeze_preconditioner_sampling": false,
            "dd_prec_enable": false
        },
        "diagnostics": {
            "pair_count_stats_enable": true,
            "sgld_log_gnoise": false,
            "sgld_log_temperature": false,
            "display_precond_every": 50,
            "wandb": {
                "enabled": true,
                "groups": {
                    "core": true,
                    "noise": true,
                    "ess_online": true,
                    "sampler": true,
                    "precond": true,
                    "fixed_eval": false,
                    "resid_rms": true,
                    "priors": false,
                    "latent_field": false,
                    "profile_shared_event_re": true,
                    "corr_error": true,
                    "sgnht": true
                }
            },
            "fim": {
                "enable_phase2": false,
                "filter_threshold": 1.0
            },
            "svrg": {
                "enabled": false
            },
            "shared_event_legcorr2d": {
                "enabled": true,
                "n_rows": 200000000,
                "batch_size": 50000000,
                "max_leg_km": 1.5,
                "n_bins": 50,
                "log_bins": true,
                "max_pairs_per_event": 10000,
                "max_pairs_total": 4000000000,
                "min_pairs_cell": 300,
                "aggregate_phases": false,
                "standardize_by_sigma": true,
                "locations_at": "map"
            },
            "resid_distribution": {
                "enabled": true,
                "residuals_at": "map",
                "make_plots": true,
                "histogram": true,
                "hist_bins": 200,
                "hist_range_s": [-0.2, 0.2],
                "histogram_initial_only": true
            },
            "shared_event_re_tau": {
                "enabled": true,
                "station_phase_re": true,
                "residuals_at": "truth",
                "n_rows": 2000000,
                "batch_size": 50000,
                "seed": 0,
                "sigma_source": "none",
                "sigma_quantile": 0.2,
                "hierarchical": false,
                "method": "logdet",
                "tau_grid_min": 0.005,
                "tau_grid_max": 0.2,
                "tau_grid_n": 16,
                "logdet_max_nodes": 800,
                "logdet_max_edges": 40000,
                "logdet_max_groups": 8
            },
            "truth_catalog": {
                "path": "./true_cat_from_yifan.csv",
                "time_source": "map",
                "time_ref": "min",
                "require_all": false
              },
            "resid_scalar_metrics": {
                "enabled": true,
                "residuals_at": "truth",
                "n_rows": 1000000,
                "batch_size": 50000,
                "sigma_source": "params",
                "sigma_quantile": 0.2,
                "min_rows_per_group": 200,
                "min_rows_per_event": 20,
                "dist_bins": 8,
                "min_rows_per_bin": 50
            }
        },
        "batching": {
            "standard": {
                "warmup": 1000000,
                "sgld": 1000000,
                "shuffle": false
            },
            "event_batches": {
                "enabled": false,
                "events_per_batch": 50,
                "max_edges_per_batch": 200000,
                "bucket_reorder_all": false,
                "bucket_reuse_epochs": 1
            }
        },
        "safety": {
            "max_abs_dX": [
                2.0,
                2.0,
                2.0,
                1.0
            ]
        },
        "runtime": {
            "phase_mads_interval": {
                "phase2": 0,
                "phase3": 0,
                "phase4": 0
            },
            "cuda_empty_cache_every": 0,
            "reset_batch_numbers": true,
            "clear_samples_on_reset": true,
            "min_samples_to_save": 10,
            "verbose": true,
            "cluster_events": false,
            "gauge_projection": {
                "enabled": false,
                "mode": "cluster",
                "dims": [
                    0,
                    1,
                    2,
                    3
                ],
                "apply_noise": true,
                "apply_momentum": true
            }
        }
    }
}
