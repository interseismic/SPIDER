# Code-only repo: ignore everything by default, except key packages
*
!.gitignore
!README.md
!.readthedocs.yaml
!spider/
!spider/**
!docs/
!docs/**
# Quickstart example: only the inputs the walkthrough needs (outputs, checkpoints, W&B runs stay ignored)
!example/
!example/SPIDER_example.json
!example/SPIDER_example_sghmc.json
!example/model_state_dict.pt
!example/dtimes_with_noise_from_truth.csv
!example/events_from_prior.csv
!example/station.csv
!spider_old/
!spider_old/**
spider/**/__pycache__/
spider/**/*.pyc
spider_old/**/__pycache__/
spider_old/**/*.pyc
docs/_build/
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/SPIDER_User_Guide.pdf
docs/nuisance_field.tex
docs/receiver_centric_autocorr.tex
