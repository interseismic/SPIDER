# Code-only repo: ignore everything by default, except key packages
*
!.gitignore
!README.md
!.readthedocs.yml
!spider/
!spider/**
!docs/
!docs/**
!spider_old/
!spider_old/**
spider/**/__pycache__/
spider/**/*.pyc
spider_old/**/__pycache__/
spider_old/**/*.pyc
docs/_build/
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/SPIDER_User_Guide.pdf
docs/SPIDER_User_Guide.tex
docs/COLLAPSED_GAUSSIAN_SHARED_EVENT_RE.md
docs/EIKONET_TRAINING.md
docs/EXAMPLES.md
docs/API_REFERENCE.md
docs/nuisance_field.tex
docs/receiver_centric_autocorr.tex
